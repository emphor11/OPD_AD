{
  "expo": {
    "name": "CareQueue",
    "slug": "carequeue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00796B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00796B"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.emphor.carequeue"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CareQueue needs your location to show the nearest hospitals and real-time bed availability."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CareQueue needs access to your photos to upload medical reports and referrals."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00796B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "653b4906-f318-43d3-a489-ab6e1b32939a"
      }
    },
    "owner": "emphor"
  }
}
